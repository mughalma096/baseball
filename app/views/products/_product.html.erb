<div id="<%= dom_id product %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= product.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= product.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Product type:</strong>
    <%= product.product_type %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Year:</strong>
    <%= product.year %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Value:</strong>
    <%= product.value %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= product.status %>
  </div>
</div>
