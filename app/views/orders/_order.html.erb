<div id="<%= dom_id order %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">User:</strong>
    <%= order.user_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Payment method:</strong>
    <%= order.payment_method_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= order.status %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Amount:</strong>
    <%= order.amount %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Discount:</strong>
    <%= order.discount %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Total amount:</strong>
    <%= order.total_amount %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Shipment:</strong>
    <%= order.shipment_id %>
  </div>
</div>
